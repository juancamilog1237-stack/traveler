---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TarjetaViaje from '../components/TarjetaViaje.astro';

const viajes = (await getCollection('viajes')).sort((a, b) => b.data.meta.fechaInvestigacion.localeCompare(a.data.meta.fechaInvestigacion));
const regiones = [...new Set(viajes.map((e) => e.data.meta.region))].sort();
---
<Base title="Traveler" description="Itinerarios y presupuestos de viaje.">
  <section id="viajes" class="container viajes" aria-labelledby="h-viajes">
    <h1 id="h-viajes" data-split>Viajes</h1>

    <div class="filtros" role="group" aria-label="Filtros">
      <div class="fila" data-filtro="region">
        <button class="chip" aria-pressed="true" data-valor="">Todas</button>
        {regiones.map((r) => <button class="chip" aria-pressed="false" data-valor={r}>{r}</button>)}
      </div>
      <div class="fila" data-filtro="dias">
        <button class="chip" aria-pressed="true" data-valor="">Cualquier duración</button>
        <button class="chip" aria-pressed="false" data-valor="0-7">Hasta 7 días</button>
        <button class="chip" aria-pressed="false" data-valor="8-14">8–14 días</button>
        <button class="chip" aria-pressed="false" data-valor="15-999">15+ días</button>
      </div>
      <div class="fila" data-filtro="cop">
        <button class="chip" aria-pressed="true" data-valor="">Cualquier presupuesto</button>
        <button class="chip" aria-pressed="false" data-valor="0-5000000">Menos de $5 M</button>
        <button class="chip" aria-pressed="false" data-valor="5000000-10000000">$5–10 M</button>
        <button class="chip" aria-pressed="false" data-valor="10000000-999999999">Más de $10 M</button>
      </div>
    </div>

    <div class="grid" data-stagger>
      {viajes.map((e) => <TarjetaViaje v={e.data} slug={e.id} />)}
    </div>
    <p class="vacio muted" hidden aria-live="polite">Sin resultados</p>
  </section>
</Base>

<script>
  function iniciarFiltros() {
    const filtros = document.querySelector('.filtros');
    if (!filtros) return;
    const estado: Record<string, string> = { region: '', dias: '', cop: '' };
    const tarjetas = [...document.querySelectorAll<HTMLElement>('.tarjeta')];
    const vacio = document.querySelector<HTMLElement>('.vacio')!;
    const enRango = (valor: number, rango: string) => { if (!rango) return true; const [a, b] = rango.split('-').map(Number); return valor >= a && valor <= b; };

    const aplicar = () => {
      // FLIP: medir antes, cambiar, animar desde la posición vieja
      const antes = new Map(tarjetas.map((t) => [t, t.getBoundingClientRect()]));
      let visibles = 0;
      tarjetas.forEach((t) => {
        const ok = (!estado.region || t.dataset.region === estado.region) && enRango(Number(t.dataset.dias), estado.dias) && enRango(Number(t.dataset.cop), estado.cop);
        t.classList.toggle('oculta', !ok);
        if (ok) visibles++;
      });
      vacio.hidden = visibles > 0;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      tarjetas.forEach((t) => {
        if (t.classList.contains('oculta')) return;
        const a = antes.get(t)!;
        const d = t.getBoundingClientRect();
        if (a.width === 0) { t.animate([{ opacity: 0, transform: 'scale(0.94)' }, { opacity: 1, transform: 'none' }], { duration: 420, easing: 'cubic-bezier(.16,1,.3,1)' }); return; }
        const dx = a.left - d.left, dy = a.top - d.top;
        if (dx || dy) t.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }], { duration: 520, easing: 'cubic-bezier(.16,1,.3,1)' });
      });
    };

    filtros.querySelectorAll<HTMLElement>('[data-filtro]').forEach((fila) => {
      fila.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
        if (!btn) return;
        fila.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        estado[fila.dataset.filtro!] = btn.dataset.valor ?? '';
        aplicar();
      });
    });
  }
  document.addEventListener('astro:page-load', iniciarFiltros);
</script>

<style>
  .viajes { padding-top: calc(var(--nav-h) + var(--space-7)); }
  h1 { margin-bottom: var(--space-6); }
  .filtros { display: grid; gap: var(--space-3); margin-bottom: var(--space-6); }
  .fila { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr)); gap: var(--space-5); }
  .vacio { padding: var(--space-6) 0; text-align: center; }
</style>
