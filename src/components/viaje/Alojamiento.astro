---
import Foto from '../Foto.astro';
import Icon from '../Icon.astro';
import { NIVELES, convertir, formato, type Viaje } from '../../lib/viaje';
interface Props { v: Viaje }
const { v } = Astro.props;
const noches = (n: number[]) => `${n.length} ${n.length === 1 ? 'noche' : 'noches'} · ${n.length === 1 ? `día ${n[0]}` : `días ${n[0]}–${n[n.length - 1]}`}`;
---
<section id="alojamiento" class="section container" aria-labelledby="h-aloj">
  <div class="section-head">
    <h2 id="h-aloj" data-split>Dónde dormir</h2>
  </div>
  <div class="cards" data-stagger>
    {v.alojamiento.map((e) => NIVELES.map(({ id: n }) => {
      const h = e[n];
      return (
        <article class="card zoom-on-hover hotel" data-reveal data-solo={n}>
          {h.imagen ? (
            <div class="media"><Foto img={h.imagen} widths={[400, 700]} sizes="(min-width: 900px) 33vw, 90vw" /></div>
          ) : (
            <div class="banda" aria-hidden="true"><Icon name="bed" /><span>{e.ciudad}</span></div>
          )}
          <div class="body">
            <p class="top"><strong>{e.ciudad}</strong><span class="muted">{noches(e.noches)}</span></p>
            <h3><a href={h.link} target="_blank" rel="noopener" class="stretched">{h.nombre}</a></h3>
            <p class="zona muted">{h.tipo} · {h.zona}</p>
            <p class="desc">{h.descripcion}</p>
            {h.incluye && <p class="incluye">{h.incluye}</p>}
            <p class="precio num">
              <strong>{formato(h.precioNoche, 'local', v)}</strong>
              <span class="muted">≈ {formato(convertir(h.precioNoche, 'local', 'COP', v), 'COP', v)} / noche</span>
            </p>
          </div>
        </article>
      );
    }))}
  </div>
</section>

<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-5); }
  .hotel { position: relative; display: flex; flex-direction: column; transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) ease; }
  .hotel:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .media { aspect-ratio: 3 / 2; }
  .media :global(img), .media :global(picture) { width: 100%; height: 100%; object-fit: cover; }
  .banda { display: flex; align-items: center; gap: 0.6rem; padding: var(--space-4) var(--space-5); background: color-mix(in srgb, var(--trip) 10%, var(--surface)); border-bottom: 1px solid var(--border); color: var(--trip); font-family: var(--font-serif); font-size: var(--step-1); }
  .body { padding: var(--space-5); display: flex; flex-direction: column; flex: 1; }
  .top { display: flex; gap: var(--space-3); align-items: baseline; justify-content: space-between; font-size: var(--step--1); margin-bottom: 0.4rem; }
  .top strong { color: var(--trip); letter-spacing: 0.08em; text-transform: uppercase; }
  h3 { margin-bottom: 0.25rem; }
  h3 a { color: var(--fg); }
  .stretched::after { content: ''; position: absolute; inset: 0; }
  .zona { font-size: var(--step--1); margin-bottom: 0.6rem; }
  .desc { font-size: 0.95rem; color: var(--muted-fg); flex: 1; }
  .incluye { font-size: var(--step--1); font-weight: 600; }
  .precio { margin: 0; font-size: var(--step--1); }
  .precio strong { font-size: var(--step-0); color: var(--fg); }
</style>
