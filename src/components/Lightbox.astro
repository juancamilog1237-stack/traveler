---
import Icon from './Icon.astro';
---
<dialog class="lightbox" aria-label="Foto ampliada">
  <figure>
    <img alt="" />
    <figcaption><span class="alt"></span> <span class="cred muted"></span></figcaption>
  </figure>
  <button class="lb-btn cerrar" type="button" aria-label="Cerrar"><Icon name="x" /></button>
  <button class="lb-btn prev" type="button" aria-label="Foto anterior"><Icon name="chevron-left" /></button>
  <button class="lb-btn next" type="button" aria-label="Foto siguiente"><Icon name="chevron-right" /></button>
  <p class="contador num" aria-live="polite"></p>
</dialog>

<script>
  type Img = { url: string; alt: string; credito?: string; licencia?: string; fuente?: string };

  function iniciarLightbox() {
    const dlg = document.querySelector<HTMLDialogElement>('dialog.lightbox');
    if (!dlg || dlg.dataset.ready) return;
    dlg.dataset.ready = '1';
    const imgEl = dlg.querySelector('img')!;
    const alt = dlg.querySelector('.alt')!;
    const cred = dlg.querySelector('.cred')!;
    const contador = dlg.querySelector('.contador')!;
    let items: HTMLElement[] = [];
    let i = 0;
    let origen: HTMLElement | null = null;

    const mostrar = (n: number, dir = 0) => {
      i = (n + items.length) % items.length;
      const btn = items[i];
      const datos: Img = JSON.parse(btn.dataset.lightbox!);
      const fuenteImg = btn.querySelector('img');
      // Usa la versión más grande disponible del srcset
      const srcset = fuenteImg?.getAttribute('srcset') ?? btn.querySelector('source[type="image/webp"]')?.getAttribute('srcset');
      const mayor = srcset ? srcset.split(',').map((s) => s.trim().split(' ')[0]).pop() : null;
      imgEl.animate?.([{ opacity: 0, transform: `translateX(${dir * 30}px)` }, { opacity: 1, transform: 'none' }], { duration: dir ? 320 : 0, easing: 'cubic-bezier(.16,1,.3,1)' });
      imgEl.src = mayor || fuenteImg?.currentSrc || datos.url;
      imgEl.alt = datos.alt;
      alt.textContent = datos.alt;
      cred.innerHTML = datos.credito ? `Foto: ${datos.fuente ? `<a href="${datos.fuente}" target="_blank" rel="noopener">${datos.credito}</a>` : datos.credito}${datos.licencia ? ` · ${datos.licencia}` : ''}` : '';
      contador.textContent = items.length > 1 ? `${i + 1} / ${items.length}` : '';
    };

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-lightbox]');
      if (!btn) return;
      items = [...document.querySelectorAll<HTMLElement>('[data-lightbox]')];
      origen = btn;
      mostrar(items.indexOf(btn));
      dlg.showModal();
      const r = btn.getBoundingClientRect();
      const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reducido) {
        const fig = dlg.querySelector('figure')!;
        const fr = fig.getBoundingClientRect();
        const sx = r.width / fr.width, sy = r.height / fr.height;
        fig.animate([
          { transform: `translate(${r.left + r.width / 2 - (fr.left + fr.width / 2)}px, ${r.top + r.height / 2 - (fr.top + fr.height / 2)}px) scale(${Math.min(sx, sy)})`, opacity: 0.4 },
          { transform: 'none', opacity: 1 },
        ], { duration: 480, easing: 'cubic-bezier(.16,1,.3,1)' });
      }
    });

    const cerrar = () => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return dlg.close();
      dlg.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 200, easing: 'ease-in' }).onfinish = () => dlg.close();
    };
    dlg.addEventListener('close', () => origen?.focus());
    dlg.querySelector('.cerrar')!.addEventListener('click', cerrar);
    dlg.querySelector('.prev')!.addEventListener('click', () => mostrar(i - 1, -1));
    dlg.querySelector('.next')!.addEventListener('click', () => mostrar(i + 1, 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) cerrar(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') mostrar(i - 1, -1);
      if (e.key === 'ArrowRight') mostrar(i + 1, 1);
      if (e.key === 'Escape') { e.preventDefault(); cerrar(); }
    });
    let x0: number | null = null;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) mostrar(i + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
      x0 = null;
    });
  }
  document.addEventListener('astro:page-load', iniciarLightbox);
</script>

<style>
  .lightbox { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgb(12 10 9 / 0.94); color: #f5f0e8; }
  .lightbox::backdrop { background: transparent; }
  figure { position: absolute; inset: 4rem 4.5rem 5rem; margin: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.8rem; }
  img { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 6px; min-height: 0; }
  figcaption { text-align: center; font-size: 0.9rem; max-width: 70ch; }
  figcaption .muted { color: #a8a29e; display: block; font-size: 0.8rem; }
  figcaption :global(a) { color: inherit; text-decoration: underline; }
  .lb-btn { position: absolute; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 999px; border: 1px solid rgb(255 255 255 / 0.25); background: rgb(255 255 255 / 0.08); color: #fff; transition: background-color 160ms ease, transform 160ms ease; }
  .lb-btn:hover { background: rgb(255 255 255 / 0.18); }
  .lb-btn:active { transform: scale(0.92); }
  .cerrar { top: 1rem; right: 1rem; }
  .prev { left: 1rem; top: 50%; margin-top: -24px; }
  .next { right: 1rem; top: 50%; margin-top: -24px; }
  .contador { position: absolute; top: 1.6rem; left: 1.2rem; margin: 0; font-size: 0.85rem; color: #a8a29e; }
  @media (max-width: 640px) { figure { inset: 4rem 0.5rem 6rem; } .prev, .next { top: auto; bottom: 1.2rem; margin: 0; } .prev { left: calc(50% - 60px); } .next { right: calc(50% - 60px); } }
</style>
