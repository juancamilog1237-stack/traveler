              "markdownDescription": "2-3 frases que venden el viaje"
            },
            "destino": {
              "type": "string"
            },
            "pais": {
              "type": "string"
            },
            "region": {
              "type": "string",
              "enum": [
                "Asia",
                "Europa",
                "Sudamérica",
                "Centroamérica y Caribe",
                "Norteamérica",
                "África",
                "Oceanía",
                "Medio Oriente"
              ]
            },
            "duracionDias": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "mesesIdeales": {
              "type": "array",
