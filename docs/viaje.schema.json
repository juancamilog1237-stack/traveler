              "markdownDescription": "Cuántas unidades locales vale 1 USD"
            },
            "copPorUSD": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Cuántos COP vale 1 USD",
              "markdownDescription": "Cuántos COP vale 1 USD"
            },
